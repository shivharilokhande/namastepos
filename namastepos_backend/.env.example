# NamastePOS backend environment configuration
# Copy this file to `.env` and fill in real values.

# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/v1
# Hardcode-audit fix (2026-08-24): removed the trailing "*" — copies of
# this template were wildcard-open in every non-production NODE_ENV.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://namastepos:namastepos@localhost:5432/namastepos
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── JWT ──────────────────────────────────────────────────────────────────
# Generate strong secrets: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=30m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# ── Admin 2FA secret encryption (OPTIONAL, strongly recommended) ─────────
# Key-encryption key for admin TOTP secrets (admin_users.totp_secret_enc).
# Generate:  openssl rand -base64 32
# Leave unset and the key is derived from JWT_SECRET instead — which means
# rotating JWT_SECRET permanently bricks every admin's 2FA. Boot logs a
# warning; it never fails. Existing secrets re-encrypt themselves under this
# key the next time the admin successfully uses a code.
TOTP_ENC_KEY=

# ── Redis (OPTIONAL) ────────────────────────────────────────────────────
# Only needed when running MORE THAN ONE backend instance. It carries cache
# invalidation (plan features, staff role/permissions, admin role/is_active)
# between instances; without it each instance falls back to its own 30-60s
# TTL, so a revocation can take that long to reach the other instances.
# Free options: Upstash, Render Key Value, Redis Cloud.
REDIS_URL=

# ── Google OAuth ─────────────────────────────────────────────────────────
# Create OAuth 2.0 Client IDs in Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
# Use the Web Client ID as audience when verifying ID tokens from mobile,
# OR list Android + iOS client IDs (comma-separated) below.
GOOGLE_CLIENT_IDS=YOUR-WEB-CLIENT-ID.apps.googleusercontent.com

# ── Razorpay (subscription billing) ───────────────────────────────────────
# Get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this in Razorpay Dashboard → Webhooks → Add Webhook, paste the same value
RAZORPAY_WEBHOOK_SECRET=

# ── Super admin (platform operator) bootstrap credentials ─────────────────
# On first run, /v1/admin/auth/login uses these to bootstrap the first admin
SUPER_ADMIN_EMAIL=admin@namastepos.in
SUPER_ADMIN_PASSWORD=change-me-on-first-login

# ── Twilio (used later when we switch back to OTP) ────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Founder protection — the admin with this email cannot be deactivated or
# demoted via the admin-team API (defaults to SUPER_ADMIN_EMAIL if unset).
FOUNDER_ADMIN_EMAIL=
