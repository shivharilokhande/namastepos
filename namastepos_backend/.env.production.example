# NamastePOS — Production .env template.
#
# Copy this file to `.env` on the prod VM, fill every REPLACE_ME, then
# do a `pm2 restart ecosystem.config.js`. Anything you leave with the
# `dev-only` / empty default here will either fail-loudly at boot (good)
# or silently disable the feature (also documented in comments).

# ── Runtime ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
API_PREFIX=/v1

# CORS — must be an explicit comma-separated list. Wildcards are
# rejected at boot in production.
CORS_ORIGINS=https://namastepos.in,https://app.namastepos.in,https://admin.namastepos.in

# ── Database ────────────────────────────────────────────────────────
# Point to your managed / self-hosted Postgres. Server must have:
#   max_connections = 200
#   shared_buffers  = 1GB   (25% of RAM on a 4GB VM)
#   effective_cache_size = 2.5GB
DATABASE_URL=postgresql://namastepos:REPLACE_ME@127.0.0.1:5432/namastepos
DB_POOL_MIN=10
DB_POOL_MAX=50    # per Node worker; N workers × 50 must stay < max_connections

# ── Auth ────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_ME_WITH_openssl_rand_base64_48
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# Key-encryption key for admin TOTP 2FA secrets (admin_users.totp_secret_enc).
#   openssl rand -base64 32
# SET THIS. Without it the 2FA KEK is derived from JWT_SECRET, so rotating
# JWT_SECRET — which you may have to do at short notice — permanently destroys
# every admin's 2FA enrolment and, with org-wide 2FA enforcement on, locks
# everyone out of the admin console. Boot only warns; it does not fail.
# Rows encrypted under the old key keep working and are re-encrypted under this
# one the next time each admin successfully uses a code. Check progress with:
#   SELECT count(*) FROM admin_users
#    WHERE totp_secret_enc IS NOT NULL AND totp_secret_enc NOT LIKE 'v2:%';
TOTP_ENC_KEY=REPLACE_ME_WITH_openssl_rand_base64_32

# ── Cross-instance cache invalidation ───────────────────────────────────
# REQUIRED once you run more than one instance (Render scale > 1, PM2 cluster).
# Staff-permission, admin-role and plan-feature caches are per-process with a
# 30-60s TTL; this Redis channel is what makes "remove staff" / "demote admin"
# take effect on EVERY instance immediately instead of only the one that
# handled the click. Single instance: safe to leave blank.
REDIS_URL=

# Google OAuth — comma-separated list of client IDs to accept
# Hardcode-audit fix (2026-08-24): real client IDs removed from this
# committed template — copy yours from Google Cloud Console > Credentials.
GOOGLE_CLIENT_IDS=<web-client-id>.apps.googleusercontent.com,<android-client-id>.apps.googleusercontent.com
# Optional: restrict to a Google Workspace domain
# GOOGLE_HD_DOMAIN=namastepos.in

# ── Rate limiting ───────────────────────────────────────────────────
# 600/min per IP = 10 req/s — covers a 10-staff cafe on shared Wi-Fi
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# ── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Razorpay ────────────────────────────────────────────────────────
# LIVE keys, not test. Generate from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_live_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# ── Super Admin bootstrap ───────────────────────────────────────────
# Only used on first boot to seed the founding admin row. Change the
# password from the /admin UI immediately after first login.
[email protected]
SUPER_ADMIN_PASSWORD=REPLACE_ME

# ── Twilio (WhatsApp Business) ──────────────────────────────────────
# Leave blank to disable auto-WhatsApp; the app will silently skip.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WA_FROM=

# ── NIC e-invoice (optional) ────────────────────────────────────────
# Only needed for turnover > ₹5 crore. Falls back to deterministic IRN.
IRP_BASE_URL=
IRP_USERNAME=
IRP_PASSWORD=

# ── Sentry (crash telemetry) ────────────────────────────────────────
# Absent → soft no-op. Please set this before launch so day-1 errors
# are visible.
SENTRY_DSN=https://REPLACE_ME.ingest.sentry.io/PROJECT_ID
APP_VERSION=1.0.0

# ── SMTP (onboarding + transactional emails, FF-223) ────────────────
# Postmark example. Absent → dispatch log records 'suppressed' and no
# real email goes out.
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
SMTP_FROM="NamastePOS <hello@namastepos.in>"

# ── App URLs ────────────────────────────────────────────────────────
# Used inside email templates so links point at the right host.
APP_URL=https://app.namastepos.in

# ── Firebase Cloud Messaging (push to the Android app) ──────────────
# FCM_PROJECT_ID           — your Firebase project id
# FCM_SERVICE_ACCOUNT_JSON — base64-encoded service-account JSON
# Blank → push silently disabled.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# ── MSG91 (SMS OTP for aggregator merchant linking) ─────────────────
# Get your key at https://control.msg91.com > API tab. Sender ID must
# be DLT-registered. Blank AUTHKEY → OTP falls back to server-log-only
# (dev behaviour). NEVER set OTP_DEV_MODE=1 in production.
MSG91_AUTHKEY=
MSG91_SENDER=
MSG91_OTP_TEMPLATE_ID=

# Founder protection — the admin with this email cannot be deactivated or
# demoted via the admin-team API (defaults to SUPER_ADMIN_EMAIL if unset).
FOUNDER_ADMIN_EMAIL=
