# NamastePOS dashboard — build-time env (Vite). Copy to .env.local for dev,
# set in the CI/Cloudflare Pages build env for production.

# API base for XHR calls. Leave unset to use same-origin '/v1'
# (recommended in prod behind a reverse proxy). Dev proxy targets this too.
VITE_API_URL=

# Origin serving /uploads static images. Leave unset for same-origin in
# prod; dev falls back to http://localhost:4000 automatically.
VITE_API_ORIGIN=

# Google OAuth Web client ID — REQUIRED for Google Sign-In.
# (See reference: Google Cloud Console > Credentials > OAuth Web client.)
VITE_GOOGLE_CLIENT_ID=

# Optional — Crisp chat widget
VITE_CRISP_WEBSITE_ID=

# Optional — Sentry crash reporting
VITE_SENTRY_DSN=

# Optional — GA4 measurement ID for the ACTIVATION FUNNEL (signup →
# business_created → menu_ready → first_kot → first_bill → upgrade_paid,
# plus plan_limit_hit). Same property the landing site uses, e.g.
# G-XXXXXXXXXX. Leave EMPTY and src/lib/analytics.ts is a hard no-op:
# gtag is never loaded, nothing is sent, nothing is logged. Even when set,
# no event fires until the owner grants analytics consent in the cookie
# banner (analytics is off by default — DPDP), and no personally
# identifiable value is ever sent (property allow-list + PII scrub in
# src/lib/analytics.ts).
VITE_GA4_ID=

# Optional — support WhatsApp number (digits with country code, e.g.
# 91XXXXXXXXXX). Unset ⇒ WhatsApp support links are hidden.
# (Hardcode-audit 2026-08-24: was previously hardcoded in source.)
VITE_SUPPORT_WHATSAPP=

# Optional — dashboard origin used in embeds/QR copy (defaults to
# window.location.origin) and brand-site domain shown on the Online Site
# page (defaults to namastepos.in).
VITE_APP_ORIGIN=
VITE_SITE_DOMAIN=
