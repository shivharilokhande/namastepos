# Root .env used by docker-compose.yml
# Copy to `.env` and fill in your secrets.

# JWT signing
JWT_SECRET=replace-with-openssl-rand-base64-48

# Google OAuth (all three IDs, comma-separated — must include the Web ID first)
GOOGLE_CLIENT_IDS=YOUR-WEB-CLIENT-ID.apps.googleusercontent.com,YOUR-ANDROID-CLIENT-ID.apps.googleusercontent.com,YOUR-IOS-CLIENT-ID.apps.googleusercontent.com

# The same Web Client ID, passed into the customer dashboard front-end
GOOGLE_WEB_CLIENT_ID=YOUR-WEB-CLIENT-ID.apps.googleusercontent.com

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Super admin bootstrap (first login uses these; change after)
SUPER_ADMIN_EMAIL=admin@namastepos.in
SUPER_ADMIN_PASSWORD=change-me-strong

# Postgres password for the compose stack (required — compose fails without it)
POSTGRES_PASSWORD=replace-me

# CORS — explicit comma-separated origins (required; "*" is rejected in prod)
# Production: https://namastepos.in,https://app.namastepos.in,https://admin.namastepos.in
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
