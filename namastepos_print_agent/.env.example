# NamastePOS Print Agent — environment

# Backend URL — must match namastepos_backend's listen address
FF_API_URL=http://localhost:3000

# Static API token for this print agent (issue via Settings → Printers → "Agent token")
FF_AGENT_TOKEN=replace_me

# Business UUID to poll for
FF_BUSINESS_ID=replace_me

# Printer transport
#   network: raw TCP on port 9100 (most networked ESC/POS printers)
#   bt:      Bluetooth SPP / RFCOMM via a device path like /dev/rfcomm0
#   file:    write bytes to a file (great for testing — no real hardware needed)
FF_PRINTER_TRANSPORT=network
FF_PRINTER_HOST=192.168.1.50
FF_PRINTER_PORT=9100
FF_PRINTER_DEVICE=/dev/rfcomm0
FF_PRINTER_FILE=./out/print.bin

# Polling cadence
FF_POLL_INTERVAL_MS=2000
